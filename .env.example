# Meta Graph API - nunca coloque o token diretamente no codigo ou no frontend
# 1) Crie um app em https://developers.facebook.com/apps (produto "Facebook Login")
# 2) Em Facebook Login > Configuracoes, adicione em "Valid OAuth Redirect URIs"
#    exatamente a mesma URL do META_REDIRECT_URI abaixo (protocolo + porta + caminho).
# 3) Preencha META_APP_ID e META_APP_SECRET (em Configuracoes > Basico do app).
# 4) Rode o servidor e acesse http://localhost:3000/auth/meta/login uma unica vez
#    para autorizar. Depois disso o token e renovado sozinho (fica salvo em
#    data/meta-token.json, que NAO deve ir para o git).
META_APP_ID=1057335563603399
META_APP_SECRET=d6c6fe07199bdf5879e81c6a1a32113d
# Deve ser IGUAL ao cadastrado no painel da Meta: mesma porta, caminho e protocolo.
# Se mudar a porta (ex.: 3001), atualize aqui E adicione a nova URL no painel da Meta.
META_REDIRECT_URI=http://localhost:3000/auth/callback
META_OAUTH_SCOPES=ads_read
META_GRAPH_VERSION=v23.0
# Opcional: usado so como fallback ANTES de voce conectar via /auth/meta/login
META_ACCESS_TOKEN=
# Opcional: por padrao o backend usa credentials/ga4-api-123456.json
GOOGLE_APPLICATION_CREDENTIALS=credentials/ga4-api-123456.json
GA4_PROPERTY_ID=553354770

SUPABASE_URL: https://olofdrngtjktrvgopyun.supabase.co/rest/v1/
